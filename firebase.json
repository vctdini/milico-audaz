{
 "hosting": {
  "public": ".",
  "ignore": [
   "firebase.json",
   "**/.*",
    "docs/**",
    "tests/**",
    "legislacao/auditoria/**",
    "**/*.md",
    "**/*.txt"
  ],
  "headers": [
   {
    "source": "/sw.js",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   }
  ]
 }
}
